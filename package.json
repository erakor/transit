{
  "name": "transit",
  "version": "0.2.0",
  "private": true,
  "description": "Small NYC transit data service: normalized JSON over the MTA, PATH, NYC Ferry and Citi Bike feeds.",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build:openapi": "tsx scripts/build-openapi.ts",
    "build:static": "tsx scripts/build-static.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint --type-aware",
    "prepare": "node .husky/install.mjs",
    "record-fixtures": "tsx scripts/record-fixtures.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "gtfs-realtime-bindings": "^2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@erakor/toolchain": "github:erakor/toolchain#v1.1.0",
    "@types/node": "^26.6.6",
    "fflate": "^0.8.3",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
