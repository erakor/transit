{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes pnpm@12.18.0 install --frozen-lockfile",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/subway/arrivals",
      "destination": "/api/subway/arrivals"
    },
    {
      "source": "/subway/alerts",
      "destination": "/api/subway/alerts"
    },
    {
      "source": "/subway/vehicles",
      "destination": "/api/subway/vehicles"
    },
    {
      "source": "/stops/search",
      "destination": "/api/stops/search"
    },
    {
      "source": "/path/:op(arrivals|stations)",
      "destination": "/api/path?op=:op"
    },
    {
      "source": "/preview/subway",
      "destination": "/api/preview/subway"
    },
    {
      "source": "/citibike/:op(station|nearby)",
      "destination": "/api/citibike?op=:op"
    },
    {
      "source": "/preview/path",
      "destination": "/api/path?op=preview"
    },
    {
      "source": "/:agency(lirr|mnr)/:op(arrivals|stations|alerts|vehicles)",
      "destination": "/api/agency?agency=:agency&op=:op"
    },
    {
      "source": "/ferry/:op(arrivals|stops|alerts|vehicles)",
      "destination": "/api/agency?agency=ferry&op=:op"
    },
    {
      "source": "/preview/:agency(lirr|mnr|ferry)",
      "destination": "/api/agency?agency=:agency&op=preview"
    },
    {
      "source": "/bus/:op(arrivals|alerts)",
      "destination": "/api/bus?op=:op"
    },
    {
      "source": "/preview/bus",
      "destination": "/api/bus?op=preview"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 15
    }
  }
}
