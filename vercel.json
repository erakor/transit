{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes pnpm@12.18.0 install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/subway/arrivals",
      "destination": "/api/subway/arrivals"
    },
    {
      "source": "/stops/search",
      "destination": "/api/stops/search"
    },
    {
      "source": "/path/arrivals",
      "destination": "/api/path/arrivals"
    },
    {
      "source": "/path/stations",
      "destination": "/api/path/stations"
    },
    {
      "source": "/preview/subway",
      "destination": "/api/preview/subway"
    },
    {
      "source": "/preview/path",
      "destination": "/api/preview/path"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 15
    }
  }
}
